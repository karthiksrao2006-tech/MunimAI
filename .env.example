# MunimAI local environment variables.
# Copy this file to ".env" (which is gitignored / never committed) and
# fill in real values. Never hardcode secrets in source files.

# Bhashini (ULCA) credentials -- get both from the "My Profile" section
# after signing up at https://bhashini.gov.in
BHASHINI_API_KEY=your_key_here
BHASHINI_USER_ID=your_user_id_here
